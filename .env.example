# Vigía — variables de entorno
# Copiá este archivo a apps/web/.env.local y completá las keys.
# NUNCA commitees .env.local con secretos reales.

# ─────────────────────────────────────────────────────────
# Anthropic — motor único de razonamiento (Claude)
# https://console.anthropic.com/settings/keys
# ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=...

# ─────────────────────────────────────────────────────────
# ElevenLabs — STT (scribe_v1) + TTS (eleven_v3)
# https://elevenlabs.io/app/settings/api-keys
# ─────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=...

# ─────────────────────────────────────────────────────────
# Voyage AI — embeddings para RAG (voyage-3)
# https://dash.voyageai.com/api-keys
# ─────────────────────────────────────────────────────────
VOYAGE_API_KEY=...

# ─────────────────────────────────────────────────────────
# Supabase — Postgres + pgvector + Storage
# https://supabase.com/dashboard/project/_/settings/api
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...
