# Vigía — variables de entorno
# Copiá este archivo a apps/web/.env.local y completá las keys.
# NUNCA commitees .env.local con secretos reales.

# ─────────────────────────────────────────────────────────
# Anthropic — motor único de razonamiento (Claude)
# https://console.anthropic.com/settings/keys
# ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=...

# ─────────────────────────────────────────────────────────
# Groq Cloud — STT (whisper-large-v3-turbo)
# https://console.groq.com/keys
# Reemplazó ElevenLabs Scribe en N21 (2026-05-07): <1s típico vs. 5-15s.
# ─────────────────────────────────────────────────────────
GROQ_API_KEY=...

# ─────────────────────────────────────────────────────────
# ElevenLabs — TTS (eleven_v3) para los 3 audios demo (render-scams).
# Ya no es STT (post-N21). Sigue requerida si se regeneran los audios demo.
# https://elevenlabs.io/app/settings/api-keys
# ─────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=...

# ─────────────────────────────────────────────────────────
# Voyage AI — embeddings para RAG (voyage-3)
# https://dash.voyageai.com/api-keys
# ─────────────────────────────────────────────────────────
VOYAGE_API_KEY=...

# ─────────────────────────────────────────────────────────
# Supabase — Postgres + pgvector + Storage
# https://supabase.com/dashboard/project/_/settings/api
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# ─────────────────────────────────────────────────────────
# Frontend dev-only — quitar cuando /api/audio/process esté en main
# ─────────────────────────────────────────────────────────
# Si está en "1", el UploadForm responde con un mock en lugar de llamar al
# endpoint real. Útil para desarrollar UI antes de que el route handler
# esté listo. Default: vacío (=usa fetch real).
NEXT_PUBLIC_MOCK_AUDIO_PROCESS=
